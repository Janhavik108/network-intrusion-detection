# MongoDB (optional: without it the pipeline reads the CSV in config/config.yaml)
MONGO_URI=mongodb://localhost:27017

# S3 artifact sync (optional)
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# MLflow (optional: defaults to a local sqlite store)
# For DagsHub use https://dagshub.com/<owner>/<repo>.mlflow
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
